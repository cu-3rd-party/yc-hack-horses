# Копируй в .env и заполняй реальными значениями; .env в git не попадает.
# --- Центральная нода (docker compose) ---
DATABASE_URL=postgres://przewalski:CHANGE_ME@postgres:5432/przewalski?sslmode=disable
LISTEN_ADDR=:8080
LOG_LEVEL=info
# Пути к сертификатам (read-only mount, не пекутся в образ)
NODE_CERT_FILE=/run/secrets/node.crt
NODE_KEY_FILE=/run/secrets/node.key
CA_FILE=/run/secrets/ca.crt
# Postgres контейнер
POSTGRES_USER=przewalski
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=przewalski
