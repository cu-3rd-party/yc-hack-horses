{
  "name": "yc-hack-horses",
  "version": "0.2.2",
  "private": true,
  "description": "Полевой журнал наблюдений за лошадьми Пржевальского",
  "author": "cu3rd <cu3rd@cu3rd.ru>",
  "homepage": "https://git.cu3rd.ru/cu3rd/yc-hack-horses",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint src",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "test:desktop": "node tests/desktop.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5",
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-slot": "^1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "axios": "^1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2",
    "electron": "45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-import": "^2",
    "fake-indexeddb": "^6",
    "idb": "^8",
    "konva": "^10",
    "lucide-react": "^0.560.0",
    "playwright-core": "^1.65.1",
    "react": "^19",
    "react-dom": "^19",
    "react-konva": "^19",
    "tailwind-merge": "^3",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^3"
  },
  "build": {
    "appId": "ru.cu3rd.ychackhorses.desktop",
    "productName": "yc-hack-horses",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs"
    ],
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "icon": "resources/icon.png"
    },
    "linux": {
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png"
    }
  }
}
